      letter-spacing: 3px;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(34px, 6vw, 56px);
      line-height: 1.2;
    }

    section {
      max-width: 850px;
      margin: 30px auto;
      padding: 35px;
      scroll-margin-top: 70px;
    }

    .card {
      padding: 25px;
      background: #fffdf8;
      border: 1px solid #e4dac5;
    }

    @media (max-width: 600px) {
      nav a {
        display: inline-block;
        margin: 5px;
      }

      .page {
        margin: 15px;
        padding: 45px 20px;
      }

      section {
